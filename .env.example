# Root environment example - copy to .env and fill in values
# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/answer-paper-correction
PYTHON_SERVICE_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# Python OCR Service
VLLM_BASE_URL=
VLLM_API_KEY=EMPTY
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
TR_OCR_MODEL_ID=microsoft/trocr-large-handwritten
DEVICE=auto
PDF_RENDER_DPI=200
MAX_PAGES=30
DESKEW=true

# Grading
GRADER_PROVIDER=auto
GRADER_BASE_URL=
GRADER_API_KEY=
GRADER_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GRADER_TIMEOUT_S=60

# OCR Backend (auto|qwen2vl|trocr|paddle|tesseract|stub)
OCR_BACKEND=auto