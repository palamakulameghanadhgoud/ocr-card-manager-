# OCR Service Environment Variables
# Copy to .env and customize

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=answer-paper-ocr-service
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OCR Backend Selection
# -----------------------------------------------------------------------------
# "auto" = pick first available from OCR_PREFERENCE
# Explicit: qwen2vl | trocr | paddle | tesseract | stub
OCR_BACKEND=auto
OCR_PREFERENCE=qwen2vl,trocr,paddle,tesseract,stub

# -----------------------------------------------------------------------------
# Qwen2.5-VL (recommended for handwriting) — two run modes:
#   1. vLLM OpenAI-compatible endpoint (set VLLM_BASE_URL) — best throughput
#   2. Local transformers (requires torch + transformers + GPU) — fallback
# -----------------------------------------------------------------------------
VLLM_BASE_URL=              # e.g. http://localhost:8000/v1
VLLM_API_KEY=EMPTY          # vLLM ignores this but client needs a value
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct

# -----------------------------------------------------------------------------
# TrOCR (line-level handwriting model)
# -----------------------------------------------------------------------------
TROCR_MODEL_ID=microsoft/trocr-large-handwritten

# -----------------------------------------------------------------------------
# Device
# -----------------------------------------------------------------------------
# auto | cuda | cpu
DEVICE=auto

# -----------------------------------------------------------------------------
# Preprocessing
# -----------------------------------------------------------------------------
PDF_RENDER_DPI=200
MAX_PAGES=30
DESKEW=true

# -----------------------------------------------------------------------------
# Grading Provider
# -----------------------------------------------------------------------------
# auto = anthropic -> openai/local -> rubric (deterministic fallback)
# Explicit: anthropic | openai | local | rubric
GRADER_PROVIDER=auto
GRADER_BASE_URL=            # OpenAI-compatible base URL (e.g. local vLLM /v1)
GRADER_API_KEY=             # API key for OpenAI-compatible endpoint
GRADER_MODEL=gpt-4o-mini    # Model for OpenAI-compatible grading
ANTHROPIC_API_KEY=          # Anthropic API key (if using Anthropic)
ANTHROPIC_MODEL=claude-sonnet-5
GRADER_TIMEOUT_S=60

# -----------------------------------------------------------------------------
# GPU / Performance (when using vLLM)
# -----------------------------------------------------------------------------
# Set in docker-compose.yml deploy.resources for GPU access